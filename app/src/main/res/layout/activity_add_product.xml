<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="THÊM NƯỚC NGỌT MỚI"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1976D2" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tên sản phẩm:" android:textStyle="bold" />
        <EditText
            android:id="@+id/edtProductName"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="VD: Pepsi Không Calo, Trà Xanh 0 Độ"
            android:background="@android:drawable/editbox_background_normal"
            android:layout_marginBottom="16dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hãng sản xuất:" android:textStyle="bold" />
        <EditText
            android:id="@+id/edtBrand"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="VD: PepsiCo, Tân Hiệp Phát"
            android:background="@android:drawable/editbox_background_normal"
            android:layout_marginBottom="16dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Giá bán (VNĐ):" android:textStyle="bold" />
        <EditText
            android:id="@+id/edtPrice"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="VD: 10000"
            android:inputType="number"
            android:background="@android:drawable/editbox_background_normal"
            android:layout_marginBottom="16dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Số lượng nhập:" android:textStyle="bold" />
        <EditText
            android:id="@+id/edtQuantity"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="VD: 24"
            android:inputType="number"
            android:background="@android:drawable/editbox_background_normal"
            android:layout_marginBottom="28dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="LƯU SẢN PHẨM"
            android:backgroundTint="#1976D2"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="HỦY BỎ"
            android:backgroundTint="#757575" />

    </LinearLayout>
</ScrollView>