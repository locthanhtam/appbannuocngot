<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="XÁC NHẬN ĐƠN HÀNG"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#EE4D2D"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sản phẩm đã chọn:"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tvOrderDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F8F8F8"
            android:padding="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:textColor="#333333"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:text="Chi tiết món..." />

        <TextView
            android:id="@+id/tvOrderTotalPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tổng tiền: 0 đ"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#EE4D2D"
            android:gravity="right"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phương thức thanh toán:"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#333333" />

        <RadioGroup
            android:id="@+id/rgPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/rbCash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💵 Tiền mặt khi nhận hàng (COD)"
                android:checked="true"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/rbQR"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 Quét mã QR chuyển khoản"
                android:textSize="14sp" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/layoutQRInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#E8F5E9"
            android:padding="12dp"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quét mã QR để thanh toán"
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/imgQRCode"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_marginTop="8dp"
                android:src="@drawable/logo_store"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ngân hàng: MB Bank\nSTK: 9999 8888 6868\nChủ TK: SHOPEE MART NƯỚC NGỌT"
                android:textColor="#333333"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnConfirmPayment"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="XÁC NHẬN THANH TOÁN"
            android:backgroundTint="#EE4D2D"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnCancelPayment"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="ĐÓNG"
            android:backgroundTint="#9E9E9E"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>